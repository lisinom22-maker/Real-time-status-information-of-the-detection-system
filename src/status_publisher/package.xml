<?xml version="1.0"?>
<package format="3">
  <name>status_publisher</name>
  <version>0.1.0</version>
  <description>System metrics publisher and Qt subscriber for ROS2 Humble.</description>
  <maintainer email="lisinom22@gmail.com">lisinom22-maker</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>status_interfaces</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_copyright</test_depend>
